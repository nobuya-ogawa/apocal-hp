{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "apps-script/**",
      "**/.*",
      "**/node_modules/**",
      "**/*debug.log",
      "**/*debug.*.log",
      "scripts/**",
      "tests/**"
    ],
    "redirects": [
      {
        "source": "/member",
        "destination": "/consulting/",
        "type": 301
      },
      {
        "source": "/member/",
        "destination": "/consulting/",
        "type": 301
      },
      {
        "source": "/member/index.html",
        "destination": "/consulting/",
        "type": 301
      }
    ],
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/check-agent-chatbot.mjs\""
    ]
  }
}
